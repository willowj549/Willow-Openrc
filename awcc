#!/sbin/openrc-run

description="Alienware Command Centre Daemon"
command="/usr/bin/awcc"
command_args="-v"
command_args_background="--daemon | logger -t awcc &"
pidfile="/run/${RC_SVCNAME}.pid"
command_user=root:root

depend() {
need acpid
want logger
}

start_pre() {
/usr/bin/rm -f /tmp/awcc.sock
}




